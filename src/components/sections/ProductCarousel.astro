---
import type { Product } from "../../types/product";
import type { ProductCardVariant } from "../../types/productCard";
import ProductCard from "../ui/ProductCard.astro";

const {
  title,
  subtitle = "Destacados",
  products = [],
  href = "#",
  id = "carousel",
  getVariant,
} = Astro.props as {
  title: string;
  subtitle?: string;
  products: Product[];
  href?: string;
  id?: string;
  getVariant?: (product: Product) => ProductCardVariant;
};
---

<section class="w-full mb-15 font-sans">
  <div class="mb-5 flex items-end justify-between gap-4 border-b border-[#1e1c18] pb-5">
    <div>
      <p class="mb-2 text-[11px] uppercase tracking-[0.3em] text-[#8b8a83]">{subtitle}</p>
      <h2 class="font-serif text-[1.4rem] font-normal tracking-[0.18em] text-[#f0ece4] md:text-[1.8rem]">{title}</h2>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={href}
        class="hidden border border-[#2a2520] px-4 py-2 text-[11px] uppercase tracking-[0.26em] text-[#f0ece4] transition-colors duration-200 hover:border-[#b4704a] sm:inline-flex"
      >
        Ver todo
      </a>

      <button
        class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-[#2a2520] text-lg text-[#f0ece4] transition-colors duration-200 hover:border-[#b4704a] md:h-10 md:w-10 md:text-xl"
        data-prev={id}
        aria-label={`Anterior ${title}`}
        type="button"
      >
        ‹
      </button>
      <button
        class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-[#2a2520] text-lg text-[#f0ece4] transition-colors duration-200 hover:border-[#b4704a] md:h-10 md:w-10 md:text-xl"
        data-next={id}
        aria-label={`Siguiente ${title}`}
        type="button"
      >
        ›
      </button>
    </div>
  </div>

  <div
    id={id}
    class:list={[
      "relative overflow-x-auto overflow-y-visible scroll-smooth pt-5",
      products.length <= 2 ? "" : "-mx-4 px-4"
    ]}
    style="scrollbar-width: none;"
  >
    <div class:list={[
      "flex gap-6 md:gap-10 snap-x snap-mandatory",
      products.length <= 2 ? "justify-start" : ""
    ]}>
      {products.map((p) => (
        <ProductCard product={p} variant={getVariant ? getVariant(p) : {}} compact={products.length <= 2} />
      ))}
    </div>
  </div>

  <script define:vars={{ id }}>
    const root = document.getElementById(id);
    if (root) {
      const prev = document.querySelector(`[data-prev="${id}"]`);
      const next = document.querySelector(`[data-next="${id}"]`);

      const scrollByCard = () => {
        const card = root.querySelector("a");
        const gap = window.innerWidth < 768 ? 24 : 40;
        return card ? card.getBoundingClientRect().width + gap : 320;
      };

      prev?.addEventListener("click", () => root.scrollBy({ left: -scrollByCard(), behavior: "smooth" }));
      next?.addEventListener("click", () => root.scrollBy({ left: scrollByCard(), behavior: "smooth" }));
    }
  </script>
</section>