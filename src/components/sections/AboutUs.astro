---
import { Icon } from "astro-icon/components";

/**
 * AboutSection.astro
 */
const phone = "3102994686";
const email = "kurubasexshop@gmail.com";
---

<section id="nosotros" class="w-full min-h-dvh border-[#1a1a18] bg-[#0a0a0a]">
  <div class="mx-auto max-w-7xl 2xl:max-w-425 px-6 md:px-10 lg:px-16 py-10 md:py-14">
    <!-- Header: logos arriba a la derecha -->
    <header
      class="flex items-center justify-center md:justify-end gap-10 md:gap-30 h-20 md:h-24"
    >
      <img
        src="/imgs/brand/paola-lazo.webp"
        alt="Paola Lazo"
        class="h-10 md:h-15 w-auto object-contain"
        loading="lazy"
      />
      <img
        src="/imgs/brand/sen-intimo.webp"
        alt="Sen Íntimo"
        class="h-14 md:h-20 w-auto object-contain"
        loading="lazy"
      />
    </header>

    <!-- Contenido: izquierda texto / derecha logo -->
    <div
      class="mt-10 md:mt-5 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-10 items-center"
    >
      <!-- Izquierda -->
      <div class="max-w-xl xl:max-w-2xl 2xl:max-w-3xl">

        <h2 class="font-serif text-[28px] md:text-3xl xl:text-4xl 2xl:text-5xl tracking-wide text-[#f0ece4]">
          Conócenos
        </h2>

        <p class="mt-6 text-base font-sans leading-relaxed xl:text-lg 2xl:text-xl text-[#8b8a83]">
          Kuruba Sexshop es un espacio creado para vivir la sexualidad con
          información, confianza y bienestar. Respaldados por la Dra. Paola
          Lazo, unimos salud íntima y placer responsable en una selección
          cuidada de productos pensados para el autocuidado y la intimidad. Aquí
          rompemos tabúes con respeto, conocimiento y discreción. Porque
          conocerte también es cuidarte
        </p>

         <h2 class="mt-10 font-serif text-[28px] md:text-3xl xl:mt-30 xl:text-4xl 2xl:text-5xl tracking-wide text-[#f0ece4]">
          Síguenos
        </h2>

        <!-- Pill social -->
        <div
          class="mt-5 inline-flex items-center gap-4 border px-5 py-3 border-[#2a2520] bg-[#14110f]"
        >
          <a
            href="https://www.instagram.com/kurubasexshop?igsh=dG1jcTdkb2U1eWQy"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="grid h-8 w-8 place-items-center transition-colors duration-200 bg-white/8 text-[#f0ece4] hover:bg-white/16"
          >
            <Icon name="instagram" class="h-5 w-5" />
          </a>

          <a
            href=""
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="grid h-8 w-8 place-items-center transition-colors duration-200 bg-white/8 text-[#f0ece4] hover:bg-white/16"
          >
            <Icon name="facebook" class="h-5 w-5" />
          </a>

          <a
            href="#"
            aria-label="TikTok"
            target="_blank"
            rel="noopener noreferrer"
            class="grid h-8 w-8 place-items-center transition-colors duration-200 bg-white/8 text-[#f0ece4] hover:bg-white/16"
          >
            <Icon name="tiktok" class="h-5 w-5" />
          </a>
        </div>

        <!-- Contacto -->
        <div class="mt-8 space-y-3 text-[#f0ece4]">
          <p class="flex items-center gap-3">
            <span class="text-[#8b8a83]">
                <Icon name="whatsapp" class="h-5 w-5" />
            </span>
            <a href={`https://wa.me/57${phone}`} target="_blank" class="text-[#b4aea3] hover:text-[#f0ece4]">
              {phone}
            </a>
          </p>

          <p class="flex items-center gap-3">
            <span class="text-[#8b8a83]">
                <Icon name="mail" class="h-5 w-5" />
            </span>
            <a href={`mailto:${email}`} class="text-[#b4aea3] hover:text-[#f0ece4]">
              {email}
            </a>
          </p>
        </div>
      </div>

      <!-- Derecha -->
      <div class="flex justify-center md:justify-end">
        <img
          src="/imgs/brand/kuruba-mark.webp"
          alt="Kuruba Sexshop"
          class="w-60 sm:w-65 md:w-75 xl:w-80 2xl:w-120"

          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>