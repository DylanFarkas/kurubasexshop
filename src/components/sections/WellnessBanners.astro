---
type BannerVariant = 'split' | 'overlay';
type BannerImagePosition = 'left' | 'right';
type BannerTextAlign = 'left' | 'center';

interface Props {
	variant?: BannerVariant;
	imageSrc: string;
	imageAlt: string;
	title: string;
	subtitle: string;
	description: string;
	ctaLabel: string;
	ctaHref: string;
	eyebrow?: string;
	imagePosition?: BannerImagePosition;
	textAlign?: BannerTextAlign;
}

const {
	variant = 'split',
	imageSrc,
	imageAlt,
	title,
	subtitle,
	description,
	ctaLabel,
	ctaHref,
	eyebrow,
	imagePosition = 'left',
	textAlign = 'left',
} = Astro.props as Props;

const isOverlay = variant === 'overlay';
const isImageRight = imagePosition === 'right';
const alignment =
	textAlign === 'center'
		? 'items-center text-center'
		: 'items-start text-left';
---

{
	isOverlay ? (
		<section class="w-full px-4 md:px-8 py-8 md:py-12">
			<article class="relative isolate overflow-hidden rounded-3xl min-h-96 md:min-h-128">
				<img
					src={imageSrc}
					alt={imageAlt}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
					sizes="100vw"
					class="absolute inset-0 h-full w-full object-cover"
				/>

				<div class="absolute inset-0 bg-linear-to-r from-black/65 via-black/35 to-black/10" />

				<div class="relative z-10 flex min-h-96 md:min-h-128 max-w-3xl flex-col justify-end gap-4 p-6 md:p-10 lg:p-12 text-white">
					{eyebrow && (
						<span class="text-xs md:text-sm uppercase tracking-[0.2em] text-rose-100">
							{eyebrow}
						</span>
					)}

					<h2 class="text-3xl md:text-5xl lg:text-6xl font-semibold leading-tight">
						{title}
					</h2>

					<p class="text-xl md:text-2xl font-medium text-rose-50/95">{subtitle}</p>

					<p class="text-base md:text-lg text-white/90 max-w-2xl">{description}</p>

					<div class="pt-2">
						<a
							href={ctaHref}
							class="inline-flex items-center justify-center rounded-full border border-white px-7 py-3 text-sm md:text-base font-semibold text-white transition-colors duration-200 motion-reduce:transition-none hover:bg-white hover:text-neutral-900"
						>
							{ctaLabel}
						</a>
					</div>
				</div>
			</article>
		</section>
	) : (
		<section class="w-full px-4 md:px-8 py-8 md:py-12">
			<article class="grid overflow-hidden rounded-3xl border border-rose-100 bg-white dark:bg-neutral-950 dark:border-neutral-800 md:grid-cols-2">
				<div class={`relative min-h-80 md:min-h-full ${isImageRight ? 'md:order-2' : ''}`}>
					<img
						src={imageSrc}
						alt={imageAlt}
						loading="lazy"
						decoding="async"
						fetchpriority="low"
						sizes="(min-width: 768px) 50vw, 100vw"
						class="absolute inset-0 h-full w-full object-cover"
					/>
				</div>

				<div class={`flex flex-col justify-center gap-4 p-6 md:p-10 lg:p-14 ${alignment}`}>
					{eyebrow && (
						<span class="text-xs md:text-sm uppercase tracking-[0.2em] text-rose-500">
							{eyebrow}
						</span>
					)}

					<h2 class="text-3xl md:text-5xl font-semibold leading-tight text-neutral-900 dark:text-neutral-50">
						{title}
					</h2>

					<p class="text-xl md:text-2xl font-medium text-neutral-800 dark:text-neutral-200">
						{subtitle}
					</p>

					<p class="text-base md:text-lg text-neutral-700 dark:text-neutral-300 max-w-xl">
						{description}
					</p>

					<div class="pt-2">
						<a
							href={ctaHref}
							class="inline-flex items-center justify-center rounded-full border border-neutral-900 px-7 py-3 text-sm md:text-base font-semibold text-neutral-900 transition-colors duration-200 motion-reduce:transition-none hover:bg-neutral-900 hover:text-white dark:border-neutral-50 dark:text-neutral-50 dark:hover:bg-neutral-50 dark:hover:text-neutral-900"
						>
							{ctaLabel}
						</a>
					</div>
				</div>
			</article>
		</section>
	)
}
