---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type BannerVariant = 'split' | 'overlay';
type BannerImagePosition = 'left' | 'right';
type BannerTextAlign = 'left' | 'center';

interface Props {
	variant?: BannerVariant;
	imageSrc: ImageMetadata;
	imageAlt: string;
	title: string;
	subtitle: string;
	description: string;
	ctaLabel: string;
	ctaHref: string;
	eyebrow?: string;
	imagePosition?: BannerImagePosition;
	textAlign?: BannerTextAlign;
}

const {
	variant = 'split',
	imageSrc,
	imageAlt,
	title,
	subtitle,
	description,
	ctaLabel,
	ctaHref,
	eyebrow,
	imagePosition = 'left',
	textAlign = 'left',
} = Astro.props as Props;

const isOverlay = variant === 'overlay';
const isImageRight = imagePosition === 'right';
const alignment =
	textAlign === 'center'
		? 'items-center text-center'
		: 'items-start text-left';
---

{
	isOverlay ? (
		<section class="w-full px-8 py-12 bg-[#0a0a0a]">
			<article class="relative isolate overflow-hidden border min-h-96 md:min-h-128 border-[#1f1b17]">
				<Image
					src={imageSrc}
					alt={imageAlt}
					widths={[768, 1024, 1536, 1920]}
					quality={68}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
					sizes="100vw"
					class="absolute inset-0 h-full w-full object-cover"
				/>

				<div class="absolute inset-0 bg-linear-to-r  from-[rgba(10,10,10,0.78)] via-[rgba(10,10,10,0.52)] to-[rgba(10,10,10,0.24)]" />

				<div class="relative z-10 flex min-h-96 md:min-h-128 max-w-3xl flex-col justify-end gap-4 p-6 md:p-10 lg:p-12 text-[#f0ece4]">
					{eyebrow && (
						<span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#ff6800]">
							{eyebrow}
						</span>
					)}

					<h2 class="font-serif text-3xl md:text-5xl lg:text-6xl leading-tight tracking-wide">
						{title}
					</h2>

					<p class="text-xl md:text-2xl text-[#ded6c8]">{subtitle}</p>

					<p class="max-w-2xl text-base md:text-lg text-[#8b8a83]">{description}</p>

					<div class="pt-2">
						<a
							href={ctaHref}
							class="inline-flex items-center justify-center border px-7 py-3 font-sans text-[12px] uppercase tracking-[0.25em] transition-colors duration-200 motion-reduce:transition-none hover:border-[#b4704a] border-[#2a2520] bg-[#14110f] text-[#f0ece4] hover:text-white"
						>
							{ctaLabel}
						</a>
					</div>
				</div>
			</article>
		</section>
	) : (
		<section class="w-full px-8 py-12 bg-[#0a0a0a]">
			<article class="grid overflow-hidden border md:grid-cols-2 border-[#1f1b17] bg-[#11100f]">
				<div class={`relative min-h-80 md:min-h-full ${isImageRight ? 'md:order-2' : ''}`}>
					<Image
						src={imageSrc}
						alt={imageAlt}
						widths={[640, 960, 1280, 1600]}
						quality={68}
						loading="lazy"
						decoding="async"
						fetchpriority="low"
						sizes="(min-width: 768px) 50vw, 100vw"
						class="absolute inset-0 h-full w-full object-cover"
					/>
				</div>

				<div class={`flex flex-col justify-center gap-4 p-6 md:p-10 lg:p-14 ${alignment}`}>
					{eyebrow && (
						<span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#ff6800]">
							{eyebrow}
						</span>
					)}

					<h2 class="font-serif text-3xl md:text-5xl leading-tight tracking-wide text-[#f0ece4]">
						{title}
					</h2>

					<p class="text-xl md:text-2xl text-[#ded6c8]">
						{subtitle}
					</p>

					<p class="max-w-xl text-base md:text-lg text-[#8b8a83]">
						{description}
					</p>

					<div class="pt-2">
						<a
							href={ctaHref}
							class="inline-flex items-center justify-center border bg-transparent px-7 py-3 font-sans text-[12px] uppercase tracking-[0.25em] transition-colors duration-200 motion-reduce:transition-none hover:border-[#b4704a] border-[#2a2520] text-[#8b8a83] hover:text-[#f0ece4]"
						>
							{ctaLabel}
						</a>
					</div>
				</div>
			</article>
		</section>
	)
}