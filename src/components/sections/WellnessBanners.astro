---
type BannerVariant = 'split' | 'overlay';
type BannerImagePosition = 'left' | 'right';
type BannerTextAlign = 'left' | 'center';

interface Props {
	variant?: BannerVariant;
	imageSrc: string;
	imageAlt: string;
	title: string;
	subtitle: string;
	description: string;
	ctaLabel: string;
	ctaHref: string;
	eyebrow?: string;
	imagePosition?: BannerImagePosition;
	textAlign?: BannerTextAlign;
}

const {
	variant = 'split',
	imageSrc,
	imageAlt,
	title,
	subtitle,
	description,
	ctaLabel,
	ctaHref,
	eyebrow,
	imagePosition = 'left',
	textAlign = 'left',
} = Astro.props as Props;

const isOverlay = variant === 'overlay';
const isImageRight = imagePosition === 'right';
const alignment =
	textAlign === 'center'
		? 'items-center text-center'
		: 'items-start text-left';
---

{
	isOverlay ? (
		<section class="w-full bg-[#f8f5ef] px-8 py-12 dark:bg-[#0a0a0a]">
			<article class="relative isolate overflow-hidden border border-[#dccfbf] min-h-96 md:min-h-128 dark:border-[#1f1b17]">
				<img
					src={imageSrc}
					alt={imageAlt}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
					sizes="100vw"
					class="absolute inset-0 h-full w-full object-cover"
				/>

				<div class="absolute inset-0 bg-linear-to-r from-[rgba(231,220,205,0.56)] via-[rgba(231,220,205,0.3)] to-[rgba(231,220,205,0.12)] dark:from-[rgba(10,10,10,0.78)] dark:via-[rgba(10,10,10,0.52)] dark:to-[rgba(10,10,10,0.24)]" />

				<div class="relative z-10 flex min-h-96 md:min-h-128 max-w-3xl flex-col justify-end gap-4 p-6 md:p-10 lg:p-12 text-[#221c15] dark:text-[#f0ece4]">
					{eyebrow && (
						<span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#9d603f] dark:text-[#b4704a]">
							{eyebrow}
						</span>
					)}

					<h2 class="font-serif text-3xl md:text-5xl lg:text-6xl leading-tight tracking-wide">
						{title}
					</h2>

					<p class="text-xl md:text-2xl text-[#3e342a] dark:text-[#ded6c8]">{subtitle}</p>

					<p class="max-w-2xl text-base md:text-lg text-[#5f5a52] dark:text-[#8b8a83]">{description}</p>

					<div class="pt-2">
						<a
							href={ctaHref}
							class="inline-flex items-center justify-center border border-[#cdb8a3] bg-[#f1e8db] px-7 py-3 font-sans text-[12px] uppercase tracking-[0.25em] text-[#2a2018] transition-colors duration-200 motion-reduce:transition-none hover:border-[#b4704a] hover:text-[#20160e] dark:border-[#2a2520] dark:bg-[#14110f] dark:text-[#f0ece4] dark:hover:text-white"
						>
							{ctaLabel}
						</a>
					</div>
				</div>
			</article>
		</section>
	) : (
		<section class="w-full bg-[#f8f5ef] px-8 py-12 dark:bg-[#0a0a0a]">
			<article class="grid overflow-hidden border border-[#dccfbf] bg-[#fbf7f1] md:grid-cols-2 dark:border-[#1f1b17] dark:bg-[#11100f]">
				<div class={`relative min-h-80 md:min-h-full ${isImageRight ? 'md:order-2' : ''}`}>
					<img
						src={imageSrc}
						alt={imageAlt}
						loading="lazy"
						decoding="async"
						fetchpriority="low"
						sizes="(min-width: 768px) 50vw, 100vw"
						class="absolute inset-0 h-full w-full object-cover"
					/>
				</div>

				<div class={`flex flex-col justify-center gap-4 p-6 md:p-10 lg:p-14 ${alignment}`}>
					{eyebrow && (
						<span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#9d603f] dark:text-[#b4704a]">
							{eyebrow}
						</span>
					)}

					<h2 class="font-serif text-3xl md:text-5xl leading-tight tracking-wide text-[#221c15] dark:text-[#f0ece4]">
						{title}
					</h2>

					<p class="text-xl md:text-2xl text-[#3e342a] dark:text-[#ded6c8]">
						{subtitle}
					</p>

					<p class="max-w-xl text-base md:text-lg text-[#5f5a52] dark:text-[#8b8a83]">
						{description}
					</p>

					<div class="pt-2">
						<a
							href={ctaHref}
							class="inline-flex items-center justify-center border border-[#d8ccbe] bg-transparent px-7 py-3 font-sans text-[12px] uppercase tracking-[0.25em] text-[#6c655b] transition-colors duration-200 motion-reduce:transition-none hover:border-[#b4704a] hover:text-[#20160e] dark:border-[#2a2520] dark:text-[#8b8a83] dark:hover:text-[#f0ece4]"
						>
							{ctaLabel}
						</a>
					</div>
				</div>
			</article>
		</section>
	)
}
