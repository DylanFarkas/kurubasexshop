---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { Product } from "../../types/product";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div
  id="products-grid"
  class="grid gap-5 bg-white grid-cols-[repeat(auto-fill,minmax(240px,1fr))] max-[480px]:grid-cols-2"
>
  {products.map((product, index) => {
    const displayPrice =
      product.final_price && product.final_price > 0
        ? product.final_price
        : product.price;

    const hasDiscount = !!product.discount_pct && product.discount_pct > 0;
    const categoryLabels =
      product.categories?.map((c) => c.label).join(",") || "";
    const firstCat = product.categories?.[0]?.label ?? null;
    const extraCats = (product.categories?.length ?? 0) - 1;
    const quickProductData = {
      productId: product.id,
      name: product.name,
      slug: product.slug,
      price: product.price,
      ...(product.final_price && { finalPrice: product.final_price }),
      image: product.image || product.images?.[0] || "/imgs/brand/logo-kuruba.png",
    };

    return (
      <article
        class="product-card reveal-on-scroll reveal-scale group relative flex flex-col overflow-hidden bg-transparent transition-colors duration-200"
        style={`--reveal-delay: ${Math.min((index % 8) * 55, 360)}ms;`}
        data-categories={categoryLabels}
        data-price={displayPrice}
        data-name={product.name}
      >
        {/* Image */}
        <div class="relative aspect-square overflow-hidden bg-white">
          {product.image ? (
            <Image
              src={product.image}
              alt={product.name}
              width={800}
              height={800}
              loading="lazy"
              decoding="async"
              format="webp"
              sizes="(max-width: 480px) 50vw, (max-width: 1024px) 33vw, 25vw"
              class="block h-full w-full object-cover transition-all duration-500 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-[1.04] group-hover:opacity-100"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center text-[#2a2520]">
              <Icon name="photo" class="h-12 w-12" />
            </div>
          )}

          {hasDiscount && (
            <span class="reveal-on-scroll absolute top-3.5 right-3.5 px-2.25 py-1.25 font-sans text-[9px] font-medium uppercase leading-none tracking-[0.16em] bg-black text-white" style={`--reveal-delay: ${Math.min((index % 8) * 55 + 120, 420)}ms;`}>
              -{product.discount_pct}%
            </span>
          )}

          {product.featured && (
            <span class="absolute top-3.5 left-3.5 bg-black px-2.25 py-1.25 font-sans text-[9px] font-medium uppercase leading-none tracking-[0.16em] text-white">
              Destacado
            </span>
          )}
        </div>

        {/* Body */}
        <div class="flex flex-1 flex-col gap-0 px-5 pt-[1.2rem] pb-[1.4rem]">
          <p class="mb-[0.65rem] flex items-center gap-1.5 font-sans text-[11px] font-normal uppercase tracking-[0.22em] text-black">
            {firstCat ? (
              <>
                <span>{firstCat}</span>
                {extraCats > 0 && (
                  <span class="text-black">+{extraCats}</span>
                )}
              </>
            ) : (
              <span>Sin categoría</span>
            )}
          </p>

          <h3 class="mb-4 flex-1 overflow-hidden font-serif text-[0.95rem] font-normal leading-[1.42] text-black line-clamp-2">
            {product.name}
          </h3>

          <div class="mb-[1.1rem] flex items-baseline gap-2.5">
            <span class="font-sans text-[1.05rem] font-medium tracking-[0.01em] text-neutral-700 ">
              ${displayPrice.toLocaleString("es-CO")}
            </span>

            {hasDiscount && (
              <span class="font-sans text-[0.78rem] font-light text-neutral-700 line-through">
                ${product.price.toLocaleString("es-CO")}
              </span>
            )}
          </div>

          <a
            href={`/producto/${product.slug}`}
            class="mt-auto block w-full cursor-pointer border border-[#1e1c18] bg-transparent px-4 py-2.75 text-center font-sans text-[12px] font-normal uppercase tracking-[0.18em] text-neutral-900 no-underline transition-all duration-200 group-hover:border-[#3a3020] group-hover:text-neutral-700 hover:border-[#b4704a] hover:bg-[#120d0a] hover:text-[#c4855a]"
          >
            Ver producto
          </a>

          <div class="mt-2.5">
            <button
              type="button"
              class="quick-add-trigger w-full cursor-pointer border border-[#1e1c18] bg-transparent px-3 py-2 text-[10px] uppercase tracking-[0.16em] text-[#1e1c18] transition-colors duration-200 hover:border-[#FF6800] hover:text-[#FF6800]"
              data-product={JSON.stringify(quickProductData)}
            >
              Añadir al carrito
            </button>
          </div>
        </div>
      </article>
    );
  })}

  <div
    id="no-products"
    class="hidden col-span-full bg-[#0a0a0a] px-8 py-24 text-center [&.show]:block"
  >
    <p class="font-serif text-[1.15rem] font-normal italic text-[#2a2520]">
      Ningún producto coincide
    </p>
    <span class="mt-2 block font-sans text-[10px] uppercase tracking-[0.2em] text-[#1e1c18]">
      Prueba con otros filtros
    </span>
  </div>
</div>

<script>
  import { useCartStore } from '../../stores/cartStore';

  function setTemporarySuccess(button: HTMLButtonElement, original: string) {
    button.textContent = '✓ Anadido';
    button.classList.add('border-[#2f6f45]', 'text-[#2f6f45]');

    setTimeout(() => {
      button.textContent = original;
      button.classList.remove('border-[#2f6f45]', 'text-[#2f6f45]');
    }, 1400);
  }

  function addToCart(product: any, button: HTMLButtonElement) {
    if (!product) return;

    useCartStore.getState().addItem({
      productId: product.productId,
      name: product.name,
      slug: product.slug,
      price: product.price,
      ...(product.finalPrice && { finalPrice: product.finalPrice }),
      image: product.image,
      quantity: 1,
    });

    setTemporarySuccess(button, button.textContent || 'Anadir');
  }

  document.querySelectorAll('.quick-add-trigger').forEach((element) => {
    element.addEventListener('click', () => {
      const button = element as HTMLButtonElement;
      const raw = button.dataset.product;
      if (!raw) return;
      addToCart(JSON.parse(raw), button);
    });
  });
</script>