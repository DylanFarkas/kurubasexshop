---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckoutForm from '../components/cart/CheckoutForm';
---

<BaseLayout title="Checkout - Kuruba Sexshop">
  <main class="relative min-h-screen overflow-hidden bg-white pt-20 pb-18 font-sans">
    <div class="relative mx-auto max-w-300 px-8">
      <section class="mb-10 border-b border-[#e9e4db] pb-8 pt-4">
        <nav class="mb-4 flex items-center gap-2 text-[12px] uppercase tracking-[0.2em] text-[#7d7265]">
          <a href="/" class="transition-colors duration-200 hover:text-[#1f1b17]">Inicio</a>
          <span aria-hidden="true">/</span>
          <span class="text-[#ff6800]">Checkout</span>
        </nav>

        <h1 class="font-serif text-[clamp(2rem,5vw,3.5rem)] leading-[1.08] tracking-wide text-[#1f1b17]">
          Finalizar Pedido
        </h1>
        <p class="mt-3 max-w-140 text-[15px] leading-[1.8] tracking-wide text-[#6b6258]">
          Completa tus datos para coordinar entrega discreta y confirmar tu compra por WhatsApp.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center border border-[#e4d8c9] bg-white px-4 py-2 text-[11px] uppercase tracking-[0.2em] text-[#6b6258]">
            Envio discreto
          </span>
          <span class="inline-flex items-center border border-[#e4d8c9] bg-white px-4 py-2 text-[11px] uppercase tracking-[0.2em] text-[#6b6258]">
            Confirmacion segura
          </span>
        </div>
      </section>

      <section class="mb-10 border border-[#e9e4db] bg-white px-5 py-5 md:px-8">
        <div class="mx-auto flex max-w-4xl items-center justify-center gap-3 md:gap-4">
          <div class="flex flex-1 items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full border border-[#d7c8b4] bg-[#f2ebe1] font-semibold text-[#1f1b17]">
              ✓
            </div>
            <span class="hidden text-sm tracking-wide text-[#6b6258] sm:block">Carrito</span>
          </div>
          <div class="h-px flex-1 bg-linear-to-r from-[#ff6800] to-[#fa0644]"></div>
          <div class="flex flex-1 items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full border border-[#b4704a] bg-[#fff1e7] font-semibold text-[#5a3925]">
              2
            </div>
            <span class="hidden text-sm tracking-wide text-[#1f1b17] sm:block">Datos</span>
          </div>
          <div class="h-px flex-1 bg-[#e0d7ca]"></div>
          <div class="flex flex-1 items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full border border-[#e0d7ca] bg-[#faf7f2] font-semibold text-[#9a9287]">
              3
            </div>
            <span class="hidden text-sm tracking-wide text-[#9a9287] sm:block">Confirmacion</span>
          </div>
        </div>
      </section>

      <section class="grid gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(320px,0.65fr)]">
        <div class="order-2 lg:order-1">
          <article class="overflow-hidden border border-[#e9e4db] bg-white">
            <header class="border-b border-[#ece4d8] bg-white px-8 py-6">
              <div class="flex items-center gap-3">
                <svg class="h-6 w-6 text-[#ff6800]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <h2 class="font-serif text-[1.7rem] leading-none tracking-wide text-[#1f1b17]">Informacion de Entrega</h2>
              </div>
              <p class="mt-2 text-sm tracking-wide text-[#6b6258]">Ingresa tus datos para procesar el envio.</p>
            </header>

            <div class="bg-white p-8">
              <CheckoutForm client:load />
            </div>
          </article>
        </div>

        <div class="order-1 lg:order-2">
          <div class="sticky top-24 space-y-5">
            <article class="overflow-hidden border border-[#1f1b17] bg-[#11100f]">
              <header class="border-b border-[#1f1b17] bg-[#151311] px-6 py-5">
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-[#ff6800]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  <h2 class="font-serif text-[1.4rem] leading-none tracking-wide text-[#f0ece4]">Resumen del Pedido</h2>
                </div>
              </header>

              <div id="cart-summary" class="p-6">
                <div class="flex items-center justify-center py-12">
                  <div class="h-8 w-8 animate-spin rounded-full border-2 border-[#2a2520] border-t-[#ff6800]"></div>
                </div>
              </div>
            </article>

            <article class="border border-[#1f1b17] bg-[#11100f] px-5 py-4">
              <div class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-[#ff6800]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <p class="text-xs leading-relaxed tracking-wide text-[#8b8a83]">
                  Tus datos y pedido se gestionan de forma privada. Te contactaremos por WhatsApp para confirmar entrega y costo de envio.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    import { useCartStore } from '../stores/cartStore';
    import { formatPrice } from '../utils/formatters';

    function renderCartSummary() {
      const items = useCartStore.getState().items;
      const total = useCartStore.getState().getTotal();
      const container = document.getElementById('cart-summary');

      if (!container) return;

      if (items.length === 0) {
        container.innerHTML = `
          <div class="rounded-2xl border border-[#2a2520] bg-[#151311] px-4 py-10 text-center">
            <svg class="mx-auto mb-4 h-16 w-16 text-[#6a6560]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <p class="mb-4 font-medium tracking-wide text-[#8b8a83]">Tu carrito esta vacio</p>
            <a href="/tienda" class="inline-flex items-center border border-[#2a2520] bg-[#14110f] px-6 py-3 text-[12px] uppercase tracking-[0.24em] text-[#f0ece4] transition-colors duration-200 hover:border-[#b4704a]">
              Ir a la tienda
            </a>
          </div>
        `;
        return;
      }

      const itemsHtml = items.map(item => {
        const price = item.finalPrice ?? item.price;
        const subtotal = price * item.quantity;
        const discount = item.finalPrice ? ((item.price - item.finalPrice) / item.price * 100) : 0;
        
        return `
          <div class="mb-4 flex gap-4 border-b border-[#2a2520] pb-4 last:mb-0 last:border-0 last:pb-0">
            <div class="relative flex-shrink-0">
              <img 
                src="${item.image || '/placeholder.png'}" 
                alt="${item.name}" 
                class="h-20 w-20 rounded-xl border border-[#2a2520] object-cover" 
              />
              ${discount > 0 ? `
                <span class="absolute -right-2 -top-2 rounded-full bg-[#fa0644] px-2 py-0.5 text-xs font-bold text-white">
                  -${Math.round(discount)}%
                </span>
              ` : ''}
            </div>
            <div class="flex-1 min-w-0">
              <p class="mb-1 line-clamp-2 text-sm font-semibold text-[#f0ece4]">${item.name}</p>
              <div class="mb-2 flex items-center gap-2">
                <span class="inline-flex items-center rounded-md border border-[#2a2520] bg-[#14110f] px-2 py-1 text-xs font-medium text-[#8b8a83]">
                  Cant: ${item.quantity}
                </span>
                ${discount > 0 ? `
                  <span class="text-xs text-[#6a6560] line-through">${formatPrice(item.price)}</span>
                ` : ''}
              </div>
              <p class="text-lg font-bold text-[#ff6800]">${formatPrice(subtotal)}</p>
            </div>
          </div>
        `;
      }).join('');

      const originalTotal = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const savings = originalTotal - total;

      container.innerHTML = `
        <div class="mb-6 space-y-4">
          ${itemsHtml}
        </div>
        
        ${savings > 0 ? `
          <div class="mb-4 rounded-lg border border-[#2f4a35] bg-[#112117] p-4">
            <div class="flex items-center gap-2 text-[#8ad3a0]">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-sm font-semibold">Estas ahorrando ${formatPrice(savings)}</span>
            </div>
          </div>
        ` : ''}
        
        <div class="space-y-3 border-t border-[#2a2520] pt-4">
          <div class="flex justify-between text-[#8b8a83]">
            <span>Subtotal (${items.length} ${items.length === 1 ? 'producto' : 'productos'})</span>
            <span class="font-medium text-[#ded6c8]">${formatPrice(total)}</span>
          </div>
          <div class="flex justify-between text-[#8b8a83]">
            <span>Envío</span>
            <span class="font-medium text-[#f0ece4]">A calcular</span>
          </div>
          <div class="border-t border-[#2a2520] pt-3">
            <div class="flex items-baseline justify-between">
              <span class="text-lg font-bold text-[#f0ece4]">Total</span>
              <div class="text-right">
                <span class="text-3xl font-bold text-[#ff6800]">${formatPrice(total)}</span>
                <p class="mt-1 text-xs text-[#6a6560]">+ costo de envio</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-6 rounded-lg border border-[#2a2520] bg-[#151311] p-4">
          <p class="text-center text-xs text-[#8b8a83]">
            El costo de envío se calculará según tu ubicación y será confirmado por WhatsApp
          </p>
        </div>
        
        <a 
          href="/tienda" 
          class="group mt-4 flex w-full items-center justify-center gap-2 border border-[#2a2520] bg-[#14110f] px-6 py-3 text-[12px] font-semibold uppercase tracking-[0.24em] text-[#f0ece4] transition-colors duration-200 hover:border-[#b4704a]"
        >
          <svg class="h-5 w-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Seguir comprando
        </a>
      `;
    }

    renderCartSummary();

    useCartStore.subscribe(renderCartSummary);
  </script>
</BaseLayout>