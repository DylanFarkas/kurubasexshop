---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import CategoriesGrid from "../components/sections/CategoriesGrid.astro";
import FeaturedCarousel from "../components/sections/FeaturedCarousel.astro";
import AboutUs from "../components/sections/AboutUs.astro";
import Feedback from "../components/sections/Feedback.astro";
import OrganizationSchema from "../components/seo/OrganizationSchema.astro";
import WellnessBanners from "../components/sections/WellnessBanners.astro";
import bannerImg1 from "../assets/banners/img1.webp";
import bannerImg2 from "../assets/banners/img2.webp";
import bannerImg5 from "../assets/banners/img5.webp";
---

<BaseLayout
  title="Kuruba Sexshop Colombia | Juguetes, Lubricantes y Más ✨"
  description="🔥 Tu sexshop de confianza en Colombia. Descubre juguetes eróticos, lubricantes premium y productos de bienestar íntimo. ✅ Envíos discretos ✅ Compra 100% segura. ¡El placer que mereces!"
  keywords="sexshop colombia, juguetes eróticos, juguetes para adultos, lubricantes, vibradores, sexshop online, tienda erótica, productos íntimos"
  image="/imgs/brand/logo-kuruba-og.svg"
>
  <OrganizationSchema slot="head" />
  <Hero />
  <CategoriesGrid />

  <WellnessBanners
    variant="overlay"
    imageSrc={bannerImg5}
    imageAlt="Producto de bienestar íntimo en una escena elegante y cálida"
    eyebrow="Descubre nuevas sensaciones"
    title="Conecta con lo que te hace sentir bien"
    subtitle="Placer consciente, femenino y moderno"
    description="Responde a lo que tu cuerpo necesita hoy y descubre opciones diseñadas para acompañarte con suavidad, confianza y calidad."
    ctaLabel="Descubrir"
    ctaHref="/tienda"
  />

  <FeaturedCarousel />

  <WellnessBanners
    variant="split"
    imageSrc={bannerImg2}
    imageAlt="Mujer en un momento íntimo de autocuidado y descanso"
    eyebrow="Bienestar íntimo"
    title="Tu placer también es autocuidado"
    subtitle="Explora a tu ritmo, sin presión"
    description="Encuentra productos pensados para sentirte segura, cómoda y conectada contigo. Todo con compra discreta y guía clara para elegir mejor."
    ctaLabel="Empezar"
    ctaHref="/tienda"
    imagePosition="left"
  />

  <Feedback />

  <WellnessBanners
    variant="overlay"
    imageSrc={bannerImg1}
    imageAlt="Escena minimalista con enfoque en confianza y exploración íntima"
    eyebrow="Confianza total"
    title="Compra sin tabúes"
    subtitle="Privacidad, apoyo y productos seleccionados"
    description="Desde lubricantes premium hasta juguetes para explorar, te acompañamos con envíos discretos y una experiencia clara de principio a fin."
    ctaLabel="Ver catálogo"
    ctaHref="/tienda"
    imagePosition="right"
  />

  <AboutUs />
</BaseLayout>