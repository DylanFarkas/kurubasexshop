  <CategoriesGrid />

  <WellnessBanners
    variant="overlay"
    imageSrc="/imgs/banners/img5.webp"
    imageAlt="Producto de bienestar íntimo en una escena elegante y cálida"
    eyebrow="Descubre nuevas sensaciones"
    title="Conecta con lo que te hace sentir bien"
    subtitle="Placer consciente, femenino y moderno"
    description="Responde a lo que tu cuerpo necesita hoy y descubre opciones diseñadas para acompañarte con suavidad, confianza y calidad."
    ctaLabel="Descubrir"
    ctaHref="/tienda"
  />

  <FeaturedCarousel
    featuredByCategory={Object.fromEntries(featuredByCategory)}
  />

  <WellnessBanners
    variant="split"
    imageSrc="/imgs/banners/img2.webp"
    imageAlt="Mujer en un momento íntimo de autocuidado y descanso"
    eyebrow="Bienestar íntimo"
    title="Tu placer también es autocuidado"
    subtitle="Explora a tu ritmo, sin presión"
    description="Encuentra productos pensados para sentirte segura, cómoda y conectada contigo. Todo con compra discreta y guía clara para elegir mejor."
