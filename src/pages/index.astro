  image="/imgs/brand/kuruba.webp"
>
  <OrganizationSchema slot="head" />
  <Hero />

  <HomeBannerCarouselSection />
  
  <CategoriesGrid />

  <WellnessBanners
    variant="overlay"
    imageSrc={bannerImg5}
    imageAlt="Producto de bienestar íntimo en una escena elegante y cálida"
    eyebrow="Descubre nuevas sensaciones"
    title="Conecta con lo que te hace sentir bien"
    subtitle="Placer consciente, femenino y moderno"
    description="Responde a lo que tu cuerpo necesita hoy y descubre opciones diseñadas para acompañarte con suavidad, confianza y calidad."
    ctaLabel="Descubrir"
    ctaHref="/tienda"
  />

  <FeaturedCarousel />

  <WellnessBanners
    variant="split"
    imageSrc={bannerImg6}
    imageAlt="Labios con brillo natural y acabado seductor"
    eyebrow="Toque irresistible"
    title="Labios que hablan por ti"
    subtitle="Brillo, sabor y actitud"
    description="Un acabado jugoso que resalta tu belleza natural, con un delicioso toque a frutos rojos que invita a disfrutar cada momento. Ligero, fácil de aplicar y simplemente irresistible."
    ctaLabel="Descubrir"
    ctaHref="/producto/brillo-labial"
    splitImageMinHeightClass="min-h-130 md:min-h-140 lg:min-h-200"
    imageObjectPositionClass="object-top"
  />

  <Feedback />

  <!-- <WellnessBanners
    variant="overlay"
    imageSrc={bannerImg1}
    imageAlt="Escena minimalista con enfoque en confianza y exploración íntima"
    eyebrow="Confianza total"
    title="Compra sin tabúes"
    subtitle="Privacidad, apoyo y productos seleccionados"
    description="Desde lubricantes premium hasta juguetes para explorar, te acompañamos con envíos discretos y una experiencia clara de principio a fin."
    ctaLabel="Ver catálogo"
    ctaHref="/tienda"
    imagePosition="right"
  /> -->

  <WellnessBanners
    variant="split"
    imageSrc={bannerImg2}
    imageAlt="Momento íntimo de conexión y bienestar"
    eyebrow="Favorito de parejas"
    title="Eleva el placer en cada momento"
    subtitle="Más duración, más intensidad"
    description="Anillo vibrador cómodo, discreto y fácil de usar. Ideal para quienes quieren llevar su experiencia a otro nivel sin complicarse"
    ctaLabel="Comprar ahora"
    ctaHref="/producto/anillo-vibrador"
    imagePosition="right"
  />

  <AboutUs />
</BaseLayout>