---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/sections/ProductGrid.astro';
import { supabase } from '../../lib/supabase';
import FilterPanel from "../../components/ui/FilterPanel.astro";
import type { Product } from '../../types/product';
import { Icon } from "astro-icon/components";
import bannerProductosHero from "../../assets/category/banner-productos.jpg";

// SSR: Renderizado del lado del servidor (dinámico)
export const prerender = false;

const { slug } = Astro.params;

// Manejo especial para la página de ofertas
const isOffersPage = slug === 'ofertas';

let category = null;
let products = null;

if (isOffersPage) {
  // Para ofertas, no hay categoría, pero creamos un objeto simulado
  category = {
    id: 'ofertas',
    label: 'Ofertas',
    slug: 'ofertas',
    active: true,
    banner_image_url: null,
    banner_public_id: null,
  };
  
  // Fetch productos con descuento
  const { data } = await supabase
    .from('products')
    .select(`
      *,
      product_categories (
        categories (
          id,
          label,
          slug
        )
      )
    `)
    .eq('active', true)
    .gt('discount_pct', 0) // Solo productos con descuento > 0
    .order('discount_pct', { ascending: false }); // Ordenar por mayor descuento primero
  
  products = data;
} else {
  // Fetch categoría normal
  const { data: categoryData } = await supabase
    .from('categories')
    .select('*')
    .eq('slug', slug)
    .eq('active', true)
    .single();

  if (!categoryData) {
    return Astro.redirect('/404');
  }
  
  category = categoryData;

  // Fetch productos de la categoría usando la tabla de unión
  const { data: productsData } = await supabase
    .from('products')
    .select(`
      *,
      product_categories!inner (
        category_id,
        categories (
          id,
          label,
          slug
        )
      )
    `)
    .eq('product_categories.category_id', category.id)
    .eq('active', true)
    .order('created_at', { ascending: false });
  
  products = productsData;
}

const mappedProducts: Product[] = (products || []).map(p => ({
  ...p,
  categories: p.product_categories?.map((pc: any) => pc.categories).filter(Boolean) || [],
  category_ids: p.product_categories?.map((pc: any) => pc.categories?.id).filter(Boolean) || [],
}));

// Descripciones SEO optimizadas por categoría
const categoryDescriptions: Record<string, { title: string; description: string; keywords: string }> = {
  'ofertas': {
    title: '🔥 Ofertas y Descuentos | Kuruba Sexshop - Hasta 30% OFF',
    description: '💰 ¡Aprovecha nuestras OFERTAS EXCLUSIVAS! Descuentos en juguetes, lubricantes y más. ¡Precios irresistibles! ⚡ Stock limitado. Compra ahora con envío discreto.',
    keywords: 'ofertas sexshop, descuentos productos eróticos, promociones juguetes sexuales'
  },
  'juguetes': {
    title: 'Juguetes Eróticos | Vibradores y Consoladores | Kuruba Sexshop',
    description: '✨ Amplia selección de juguetes eróticos: vibradores, consoladores, bullets, huevos vibradores y más. Para ella, para él y parejas. ¡Placer garantizado!',
    keywords: 'juguetes eróticos, vibradores, consoladores, juguetes sexuales, sex toys colombia'
  },
  'lubricantes': {
    title: 'Lubricantes Íntimos | Base Agua y Silicona | Kuruba Sexshop',
    description: '💧 Lubricantes de calidad premium: base agua, silicona, efecto calor y más. Compatibles con preservativos. ¡Máximo placer sin límites!',
    keywords: 'lubricantes íntimos, lubricantes sexuales, lubricante base agua, lubricante silicona'
  },
  // 'lenceria': {
  //   title: 'Lencería Sensual y Sexy | Conjuntos Eróticos | Kuruba Sexshop',
  //   description: '👙 Lencería sexy para conquistar: conjuntos, baby dolls, corsés, disfraces y más. Todas las tallas. ¡Siéntete irresistible!',
  //   keywords: 'lencería sensual, lencería sexy, ropa interior erótica, baby doll, corsés'
  // },
  // 'bondaje': {
  //   title: 'Bondaje y BDSM | Esposas, Cuerdas y Más | Kuruba Sexshop',
  //   description: '🔗 Explora el bondaje: esposas, vendas, látigos, cuerdas y accesorios BDSM. Para principiantes y expertos. ¡Atrévete a más!',
  //   keywords: 'bondaje, bdsm, esposas, látigos, juegos de dominación, accesorios bdsm'
  // },
  'masculino': {
    title: 'Productos Masculinos | Anillos, Masturbadores | Kuruba Sexshop',
    description: '💪 Productos diseñados para él: anillos vibradores, masturbadores, bombas, extensores y más. ¡Potencia tu placer!',
    keywords: 'productos masculinos, masturbadores, anillos vibradores, juguetes para hombres'
  },
  'bienestar-intimo': {
    title: 'Bienestar Íntimo | Cuidado Personal | Kuruba Sexshop',
    description: '🌸 Productos para tu bienestar: limpiadores íntimos, aceites de masaje, bolas chinas y más. Cuida tu salud sexual.',
    keywords: 'bienestar íntimo, cuidado personal, aceites masaje, bolas chinas, limpiadores íntimos'
  }
};

const seoData = categoryDescriptions[slug as string] || {
  title: `${category.label} | Kuruba Sexshop Colombia`,
  description: `Descubre nuestra selección de ${category.label.toLowerCase()}. Productos de calidad con envío discreto a toda Colombia. ¡Compra segura!`,
  keywords: `${category.label.toLowerCase()}, productos eróticos, sexshop colombia`
};

const fallbackCategoryHero = bannerProductosHero.src;
const categoryHeroImage = category.banner_image_url || fallbackCategoryHero;
const categoryHeroAlt = isOffersPage
  ? 'Banner de ofertas de Kuruba SexShop'
  : `Banner de la categoria ${category.label}`;
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  keywords={seoData.keywords}
>
  <main class="min-h-screen bg-white pb-20">
    <section class="relative overflow-hidden border-b border-[#1e1c18] bg-[#0a0a0a] px-8 pt-20 pb-18">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <img
          src={categoryHeroImage}
          alt={categoryHeroAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover opacity-[0.90]"
        />
        <div class="absolute inset-0 z-1 bg-linear-to-b from-[rgba(10,10,10,0.55)] to-[rgba(10,10,10,0.86)]"></div>
        <div class="pointer-events-none absolute inset-0 z-1 bg-[radial-gradient(ellipse_90%_70%_at_75%_40%,rgba(180,80,50,0.07)_0%,transparent_65%)]"></div>
      </div>

      <div class="relative z-2 mx-auto max-w-300">
        <div class="mb-[1.6rem] flex items-center gap-3 font-sans text-[12px] font-normal uppercase tracking-[0.3em] text-[#fa0644] before:inline-block before:h-px before:w-7 before:shrink-0 before:bg-current before:content-['']">
          Kuruba SexShop
        </div>

        <h1 class="mb-[1.4rem] max-w-175 font-serif text-[clamp(2.2rem,5vw,4rem)] tracking-wide leading-[1.1] text-[#f0ece4]">
          {isOffersPage ? 'Ofertas destacadas' : category.label}
        </h1>

        <p class="mb-[2.8rem] max-w-120 font-sans text-[15px] tracking-wide font-light leading-[1.75] text-[#d4cdc1]">
          {isOffersPage 
            ? 'Aprovecha nuestros mejores descuentos y promociones especiales con disponibilidad limitada.'
            : `Descubre nuestra selección exclusiva de ${category.label.toLowerCase()} con envío discreto a toda Colombia.`
          }
        </p>

        <div class="flex flex-wrap items-center gap-[2.8rem] max-sm:gap-[1.8rem]">
          <div class="flex flex-col gap-1">
            <span id="product-count" class="font-serif text-[1.7rem] font-normal leading-none text-[#f0ece4]">
              {mappedProducts.length}
            </span>
            <span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#8b8a83]">
              {isOffersPage ? 'En oferta' : 'Productos'}
            </span>
          </div>

          <div class="h-9 w-px shrink-0 bg-[#1e1c18] max-sm:hidden"></div>

          <div class="flex flex-col gap-1">
            <span class="font-serif text-[1.7rem] font-normal leading-none text-[#f0ece4]">
              100%
            </span>
            <span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#8b8a83]">
              Envío discreto
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-300 px-8">
      <div class="flex flex-wrap items-end justify-between gap-6 border-[#1a1a18] py-12 pb-[2.2rem] max-sm:pt-8">
        <div>
          <p class="mb-2 font-sans text-[12px] uppercase tracking-[0.3em] text-[#000000]">
            {isOffersPage ? 'Promociones activas' : 'Catálogo por categoría'}
          </p>
          <h2 class="font-serif text-[2rem] tracking-widest font-normal leading-none text-[#000000] max-sm:text-[1.6rem]">
            {category.label}
          </h2>
        </div>

        <button
          id="open-filters"
          class="inline-flex cursor-pointer items-center gap-2.5 border border-[#2a2520] bg-transparent px-6 py-2.75 font-sans tracking-[5px] text-[12px] font-normal uppercase text-black transition-colors duration-200 hover:border-[#b4704a]"
          aria-label="Abrir filtros"
        >
          <Icon name="filter" size={20} />
          Filtrar catálogo
        </button>
      </div>

      {mappedProducts.length > 0 ? (
        <div class="">
          <ProductGrid products={mappedProducts} />
        </div>
      ) : (
        <div class="px-8 py-20 text-center text-[#1e1c18]">
          <p class="font-serif text-[1.1rem] italic">
            {isOffersPage ? 'No hay productos en oferta en este momento' : 'No hay productos disponibles en esta categoría'}
          </p>
          <a href="/tienda" class="mt-4 inline-block font-sans text-[12px] uppercase tracking-[0.22em] text-black hover:text-[#b4704a]">
            Ver todos los productos
          </a>
        </div>
      )}
    </div>
    
    <FilterPanel showCategoryFilter={false} />
  </main>
</BaseLayout>