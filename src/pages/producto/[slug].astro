---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import { formatPrice, formatTextToHtml } from '../../utils/formatters';
import type { Product } from '../../types/product';
import { Icon } from 'astro-icon/components';
import ProductSchema from '../../components/seo/ProductSchema.astro';

// SSR: Renderizado del lado del servidor (dinámico)
export const prerender = false;

const { slug } = Astro.params;

// Fetch producto con categorías
const { data: product, error } = await supabase
  .from('products')
  .select(`
    *,
    product_categories (
      categories (
        id,
        label,
        slug
      )
    )
  `)
  .eq('slug', slug)
  .eq('active', true) 
  .single();

if (error || !product) {
  return Astro.redirect('/404');
}

const mappedProduct: Product = {
  ...product,
  categories: product.product_categories?.map((pc: any) => pc.categories).filter(Boolean) || [],
  category_ids: product.product_categories?.map((pc: any) => pc.categories?.id).filter(Boolean) || [],
};

const galleryImages = [
  mappedProduct.image,
  ...(mappedProduct.images || [])
].filter(Boolean);

const displayPrice = mappedProduct.final_price || mappedProduct.price;
const hasDiscount = !!mappedProduct.discount_pct && mappedProduct.discount_pct > 0;

// SEO optimizado para productos
const productTitle = `${mappedProduct.name} | Comprar en Kuruba Sexshop`;
const productDescription = mappedProduct.description 
  ? `${mappedProduct.description.substring(0, 150)}... 💰 ${formatPrice(displayPrice)} ${hasDiscount ? `🔥 ${mappedProduct.discount_pct}% OFF` : ''} ✅ Envío discreto ✅ Compra segura`
  : `Compra ${mappedProduct.name} en Kuruba Sexshop. Precio: ${formatPrice(displayPrice)}. Envío discreto a toda Colombia. ¡Calidad garantizada!`;

const categoryLabels = (mappedProduct.categories || []).map(c => c.label).join(', ');
const productKeywords = `${mappedProduct.name}, comprar ${mappedProduct.name}${categoryLabels ? `, ${categoryLabels}` : ''}, sexshop colombia`;
---

<BaseLayout 
  title={productTitle}
  description={productDescription}
  keywords={productKeywords}
  image={mappedProduct.image || '/imgs/brand/logo-kuruba.png'}
  type="product"
>
  {mappedProduct.image && <ProductSchema product={mappedProduct} slot="head" />}
  <main class="container mx-auto px-4 pt-20 pb-16 text-[#1e1c18] bg-[#f8f5ef] dark:text-[#f0ece4] dark:bg-[#0A0A0A] font-sans">
    <div class="grid md:grid-cols-2 md:gap-10 lg:gap-5">
      <!-- Galería de imágenes -->
      <div class="space-y-4">
        <div class="aspect-square max-w-lg overflow-hidden rounded-3xl border border-[#ddd4c8] bg-[#f2ece2] dark:border-[#1a1a18] dark:bg-[#0f0f0d]">
          <img
            id="main-image"
            src={mappedProduct.image || '/placeholder.png'}
            alt={mappedProduct.name}
            class="w-full h-full object-cover"
          />
        </div>
        
        {galleryImages.length > 1 && (
          <div class="grid grid-cols-4 w-full gap-4">
            {galleryImages.map((img, i) => (
              <button
                class="thumbnail-btn aspect-square overflow-hidden rounded-lg border border-[#d8d2c8] transition hover:border-[#b4704a] dark:border-[#2a2520] dark:hover:border-[#8b8a83]"
                data-image={img}
              >
                <img src={img} alt={`${mappedProduct.name} ${i + 1}`} class="w-full h-full rounded-lg object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="space-y-4">
        {mappedProduct.categories && mappedProduct.categories.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {mappedProduct.categories.map((cat) => (
              <a
                href={`/categoria/${cat.slug}`}
                class="inline-block rounded-full border border-[#d8d2c8] bg-[#f6f1e7] px-3 py-1 text-sm text-[#5b5144] transition hover:border-[#b4704a] hover:text-[#b4704a] dark:border-[#2a2520] dark:bg-[#131210] dark:text-[#b6ad9e] dark:hover:border-[#f0ece4] dark:hover:text-[#f0ece4]"
              >
                {cat.label}
              </a>
            ))}
          </div>
        )}
        
        <h1 class="font-serif text-4xl font-normal tracking-wide">{mappedProduct.name}</h1>
        
        <div class="flex items-baseline gap-3">
          <span class="text-4xl font-semibold">{formatPrice(displayPrice)}</span>
          {hasDiscount && (
            <>
              <span class="text-xl text-[#8b8a83] line-through">{formatPrice(mappedProduct.price)}</span>
              <span class="rounded border border-[#fa0644]/40 bg-[#fa0644]/10 px-2 py-1 text-sm font-semibold text-[#fa0644]">
                -{mappedProduct.discount_pct}%
              </span>
            </>
          )}
        </div>
        
          <div class="flex items-center gap-5">
            <label for="quantity" class="font-semibold uppercase tracking-widest text-[#5b5144] dark:text-[#b6ad9e]">Cantidad:</label>
            <div class="flex items-center rounded-full border border-[#d8d2c8] bg-[#f8f5ef] px-2 py-1 shadow-sm dark:border-[#2a2520] dark:bg-[#11110f] dark:text-[#f0ece4]">
              <button
                id="decrease-qty"
                type="button"
                class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-[#d4c8b8] bg-[#efe6da] text-2xl font-bold transition hover:border-[#b4704a] hover:text-[#b4704a] focus:outline-none dark:border-[#2a2520] dark:bg-[#1a1a18] dark:hover:border-[#8b8a83] dark:hover:text-[#f0ece4]"
                aria-label="Disminuir cantidad"
                >
                <Icon name="minus" size={20} />
              </button>
              <input
                id="quantity"
                type="number"
                min="1"
                value="1"
                class="mx-2 w-14 border-none bg-transparent py-2 text-center text-lg font-semibold text-[#1e1c18] transition focus:outline-none dark:text-[#f0ece4]"
                style="appearance: none;"
              />
              <button
                id="increase-qty"
                type="button"
                class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-[#d4c8b8] bg-[#efe6da] text-2xl font-bold transition hover:border-[#b4704a] hover:text-[#b4704a] focus:outline-none dark:border-[#2a2520] dark:bg-[#1a1a18] dark:hover:border-[#8b8a83] dark:hover:text-[#f0ece4]"
                aria-label="Aumentar cantidad"
              >
              <Icon name="plus" size={20} />
              </button>
            </div>
          </div>
        
        <div class="space-y-3">
          <button
            id="add-to-cart"
            data-product={JSON.stringify({
              productId: mappedProduct.id,
              name: mappedProduct.name,
              slug: mappedProduct.slug,
              price: mappedProduct.price,
              ...(mappedProduct.final_price && { finalPrice: mappedProduct.final_price }),
              image: mappedProduct.image,
            })}
            class="w-full cursor-pointer border border-[#2a2520] bg-transparent py-4 font-medium uppercase tracking-[0.16em] text-[#1e1c18] transition duration-200 hover:border-[#b4704a] hover:text-[#b4704a] dark:border-[#8b8a83] dark:text-[#f0ece4] dark:hover:border-[#f0ece4]"
          >
            Añadir al carrito
          </button>
          
          <a
            href="/tienda"
            class="block w-full border border-[#c8c1b7] py-4 text-center font-medium uppercase tracking-[0.16em] text-[#5b5144] transition hover:border-[#b4704a] hover:text-[#b4704a] dark:border-[#2a2520] dark:text-[#b6ad9e] dark:hover:border-[#f0ece4] dark:hover:text-[#f0ece4]"
          >
            Seguir comprando
          </a>
        </div>

        {mappedProduct.description && (
          <div class="overflow-hidden rounded-xl border border-[#d8d2c8] bg-[#fbf8f2] shadow-sm transition-shadow duration-300 hover:shadow-md dark:border-[#1a1a18] dark:bg-[#10100f]">
            <button
              id="description-toggle"
              type="button"
              class="flex w-full cursor-pointer items-center justify-between px-6 py-4 text-left font-semibold text-[#1e1c18] transition-colors duration-200 dark:bg-[#0f0f0d] dark:text-[#f0ece4]"
              aria-expanded="false"
              aria-controls="description-content"
            >
              <span class="text-base">Descripción del producto</span>
              <Icon 
                id="description-icon"
                name="chevron-down" 
                size={20}
                class="transition-transform duration-300 ease-in-out"
              />
            </button>
            <div
              id="description-content"
              class="description-panel overflow-hidden px-6 leading-relaxed text-[#4b4339] dark:bg-[#0f0f0d] dark:text-[#d5cfc4]"
              style="max-height: 0; opacity: 0;"
            >
              <div 
                class="pb-6 description-content-inner text-sm"
                set:html={formatTextToHtml(mappedProduct.description)}
              />
            </div>
          </div>
        )}
        
        <div class="space-y-2 pt-8 text-sm text-[#3f382f] dark:text-[#b6ad9e]">
          <div class="mb-6 flex w-full items-center justify-center border-t border-[#cfc6b8] dark:border-[#1a1a18]"></div>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Producto bajo pedido (sin límite de stock)
          </p>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Envío discreto
          </p>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Pago seguro
          </p>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Atención personalizada
          </p>
        </div>
      </div>
    </div>
  </main>

  <style>
    .description-content-inner :global(*) {
      color: inherit;
    }

    .description-content-inner :global(p) {
      margin-bottom: 0.75rem;
    }
    .description-content-inner :global(p:last-child) {
      margin-bottom: 0;
    }
    .description-content-inner :global(strong) {
      font-weight: 700;
    }
    .description-content-inner :global(em) {
      font-style: italic;
    }
    
    .description-panel {
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
                  opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  padding-top 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .description-panel.expanded {
      opacity: 1;
      padding-top: 1rem;
    }
  </style>

  <script>
    import { useCartStore } from '../../stores/cartStore';

    // Toggle descripción con animación fluida
    const descriptionToggle = document.getElementById('description-toggle');
    const descriptionContent = document.getElementById('description-content') as HTMLElement;
    const descriptionIcon = document.getElementById('description-icon');
    
    if (descriptionToggle && descriptionContent) {
      descriptionToggle.addEventListener('click', () => {
        const isExpanded = descriptionToggle.getAttribute('aria-expanded') === 'true';
        
        if (isExpanded) {
          // Colapsar
          descriptionContent.style.maxHeight = '0';
          descriptionContent.style.opacity = '0';
          descriptionContent.classList.remove('expanded');
          descriptionToggle.setAttribute('aria-expanded', 'false');
          descriptionIcon?.classList.remove('rotate-180');
        } else {
          // Expandir
          descriptionContent.classList.add('expanded');
          const scrollHeight = descriptionContent.scrollHeight;
          descriptionContent.style.maxHeight = scrollHeight + 'px';
          descriptionContent.style.opacity = '1';
          descriptionToggle.setAttribute('aria-expanded', 'true');
          descriptionIcon?.classList.add('rotate-180');
        }
      });
    }

    // Cambio de imagen en galería
    const mainImage = document.getElementById('main-image') as HTMLImageElement;
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    
    thumbnails.forEach(btn => {
      btn.addEventListener('click', () => {
        const newSrc = (btn as HTMLElement).dataset.image;
        if (newSrc && mainImage) {
          mainImage.src = newSrc;
        }
      });
    });
    
    // Control de cantidad
    const quantityInput = document.getElementById('quantity') as HTMLInputElement;
    const decreaseBtn = document.getElementById('decrease-qty');
    const increaseBtn = document.getElementById('increase-qty');
    
    decreaseBtn?.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value) || 1;
      if (currentValue > 1) {
        quantityInput.value = String(currentValue - 1);
      }
    });
    
    increaseBtn?.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value) || 1;
      quantityInput.value = String(currentValue + 1);
    });
    
    // Validar que el input siempre sea >= 1
    quantityInput?.addEventListener('change', () => {
      const value = parseInt(quantityInput.value) || 1;
      if (value < 1) {
        quantityInput.value = '1';
      }
    });
    
    // Añadir al carrito
    const addToCartBtn = document.getElementById('add-to-cart');
    addToCartBtn?.addEventListener('click', () => {
      const productData = addToCartBtn.dataset.product;
      if (productData) {
        const product = JSON.parse(productData);
        const quantity = parseInt(quantityInput?.value || '1');
        
        useCartStore.getState().addItem({
          ...product,
          quantity: quantity,
        });
        
        const originalText = addToCartBtn.textContent;
        addToCartBtn.textContent = '✓ Añadido al carrito';
        addToCartBtn.classList.add('bg-green-600', 'text-white', 'border-green-700');
        
        setTimeout(() => {
          addToCartBtn.textContent = originalText;
          addToCartBtn.classList.remove('bg-green-600', 'text-white', 'border-green-700');
        }, 2000);
      }
    });
  </script>
</BaseLayout>