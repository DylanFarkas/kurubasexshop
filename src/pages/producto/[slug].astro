---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import { formatPrice, formatTextToHtml } from '../../utils/formatters';
import type { Product } from '../../types/product';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import ProductSchema from '../../components/seo/ProductSchema.astro';
import ProductGrid from '../../components/sections/ProductGrid.astro';

// SSR: Renderizado del lado del servidor (dinámico)
export const prerender = false;

const { slug } = Astro.params;

// Fetch producto con categorías
const { data: product, error } = await supabase
  .from('products')
  .select(`
    *,
    product_categories (
      categories (
        id,
        label,
        slug
      )
    )
  `)
  .eq('slug', slug)
  .eq('active', true) 
  .single();

if (error || !product) {
  return Astro.redirect('/404');
}

const mapProductWithCategories = (item: any): Product => ({
  ...item,
  categories: item.product_categories?.map((pc: any) => pc.categories).filter(Boolean) || [],
  category_ids: item.product_categories?.map((pc: any) => pc.categories?.id).filter(Boolean) || [],
});

const mappedProduct: Product = mapProductWithCategories(product);

const currentCategoryIds = mappedProduct.category_ids || [];
let relatedProducts: Product[] = [];

if (currentCategoryIds.length > 0) {
  const { data: relatedProductsData } = await supabase
    .from('products')
    .select(`
      *,
      product_categories!inner (
        category_id,
        categories (
          id,
          label,
          slug
        )
      )
    `)
    .in('product_categories.category_id', currentCategoryIds)
    .eq('active', true)
    .neq('id', mappedProduct.id)
    .order('featured', { ascending: false })
    .order('created_at', { ascending: false })
    .limit(24);

  relatedProducts = Array.from(
    new Map((relatedProductsData || []).map((item: any) => [item.id, item])).values(),
  )
    .map((item: any) => {
      const normalized = mapProductWithCategories(item);
      const sharedCategories = normalized.category_ids?.filter((id) =>
        currentCategoryIds.includes(id),
      ).length || 0;

      return { normalized, sharedCategories };
    })
    .sort((a, b) => b.sharedCategories - a.sharedCategories)
    .slice(0, 4)
    .map((entry) => entry.normalized);
}

if (relatedProducts.length === 0) {
  const { data: fallbackProductsData } = await supabase
    .from('products')
    .select(`
      *,
      product_categories (
        categories (
          id,
          label,
          slug
        )
      )
    `)
    .eq('active', true)
    .neq('id', mappedProduct.id)
    .order('featured', { ascending: false })
    .order('created_at', { ascending: false })
    .limit(4);

  relatedProducts = (fallbackProductsData || []).map(mapProductWithCategories).slice(0, 4);
}

const galleryImages = [
  mappedProduct.image,
  ...(mappedProduct.images || [])
].filter((img): img is string => typeof img === 'string' && img.length > 0);
const mainGalleryImage = galleryImages[0] ?? null;

const displayPrice = mappedProduct.final_price || mappedProduct.price;
const hasDiscount = !!mappedProduct.discount_pct && mappedProduct.discount_pct > 0;

// SEO optimizado para productos
const productTitle = `${mappedProduct.name} | Comprar en Kuruba Sexshop`;
const productDescription = mappedProduct.description 
  ? `${mappedProduct.description.substring(0, 150)}... 💰 ${formatPrice(displayPrice)} ${hasDiscount ? `🔥 ${mappedProduct.discount_pct}% OFF` : ''} ✅ Envío discreto ✅ Compra segura`
  : `Compra ${mappedProduct.name} en Kuruba Sexshop. Precio: ${formatPrice(displayPrice)}. Envío discreto a toda Colombia. ¡Calidad garantizada!`;

const categoryLabels = (mappedProduct.categories || []).map(c => c.label).join(', ');
const productKeywords = `${mappedProduct.name}, comprar ${mappedProduct.name}${categoryLabels ? `, ${categoryLabels}` : ''}, sexshop colombia`;
const stickyShortName = mappedProduct.name.length > 44
  ? `${mappedProduct.name.slice(0, 41)}...`
  : mappedProduct.name;
---

<BaseLayout
  title={productTitle}
  description={productDescription}
  keywords={productKeywords}
  image={mappedProduct.image || '/imgs/brand/kuruba.webp'}
  type="product"
>
  {mappedProduct.image && <ProductSchema product={mappedProduct} slot="head" />}
  <main class="container mx-auto px-4 pt-20 pb-16 text-[#1e1c18] bg-[white] font-sans">
    <div class="grid md:grid-cols-2 md:gap-10 lg:gap-5">
      <!-- Galería de imágenes -->
      <div class="space-y-4">
        <div class="aspect-square max-w-lg overflow-hidden rounded-xl border border-gray-200 bg-white">
          {mainGalleryImage ? (
            <Image
              id="main-image"
              src={mainGalleryImage}
              alt={mappedProduct.name}
              width={1000}
              height={1000}
              loading="eager"
              decoding="async"
              format="webp"
              sizes="(max-width: 768px) 100vw, 50vw"
              class="w-full h-full object-cover"
            />
          ) : (
            <div id="main-image" class="flex h-full w-full items-center justify-center text-[#8b8a83]">
              <Icon name="photo" class="h-14 w-14" />
            </div>
          )}
        </div>
        
        {galleryImages.length > 1 && (
          <div class="grid w-full max-w-lg grid-cols-4 gap-4">
            {galleryImages.map((img: string, i) => (
              <button
                class="thumbnail-btn aspect-square overflow-hidden rounded-lg border border-gray-200 transition hover:border-[#FF6800]"
                data-image={img}
              >
                <Image
                  src={img}
                  alt={`${mappedProduct.name} ${i + 1}`}
                  width={280}
                  height={280}
                  loading="lazy"
                  decoding="async"
                  format="webp"
                  sizes="(max-width: 768px) 20vw, 10vw"
                  class="w-full h-full rounded-lg object-cover"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="space-y-4">
        {mappedProduct.categories && mappedProduct.categories.length > 0 && (
          <div class="reveal-on-scroll flex flex-wrap gap-2 md:mt-0 mt-5" style="--reveal-delay: 40ms;">
            {mappedProduct.categories.map((cat) => (
              <a
                href={`/categoria/${cat.slug}`}
                class="inline-block rounded-full border border-[#d8d2c8] bg-white px-3 py-1 text-sm text-neutral-700 transition hover:border-[#b4704a] hover:text-[#b4704a]"
              >
                {cat.label}
              </a>
            ))}
          </div>
        )}
        
        <h1 class="reveal-on-scroll font-sans text-4xl font-normal tracking-wide" style="--reveal-delay: 100ms;">{mappedProduct.name}</h1>
        
        <div class="reveal-on-scroll flex items-baseline gap-3" style="--reveal-delay: 160ms;">
          <span class="text-4xl font-semibold">{formatPrice(displayPrice)}</span>
          {hasDiscount && (
            <>
              <span class="text-xl text-[#8b8a83] line-through">{formatPrice(mappedProduct.price)}</span>
              <span class="rounded border border-[#fa0644]/40 bg-[#fa0644]/10 px-2 py-1 text-sm font-semibold text-[#fa0644]">
                -{mappedProduct.discount_pct}%
              </span>
            </>
          )}
        </div>
        
          <div class="flex items-center gap-5">
            <label for="quantity" class="font-semibold uppercase tracking-widest text-[#5b5144]">Cantidad:</label>
            <div class="flex items-center rounded-full border border-[#d8d2c8] bg-white px-2 py-1 shadow-sm">
              <button
                id="decrease-qty"
                type="button"
                class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-[#d4c8b8] bg-white text-2xl font-bold transition hover:border-[#b4704a] hover:text-[#b4704a] focus:outline-none"
                aria-label="Disminuir cantidad"
                >
                <Icon name="minus" size={20} />
              </button>
              <input
                id="quantity"
                type="number"
                min="1"
                value="1"
                class="mx-2 w-14 border-none bg-transparent py-2 text-center text-lg font-semibold text-[#1e1c18] transition focus:outline-none"
                style="appearance: none;"
              />
              <button
                id="increase-qty"
                type="button"
                class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-[#d4c8b8] bg-white text-2xl font-bold transition hover:border-[#b4704a] hover:text-[#b4704a] focus:outline-none"
                aria-label="Aumentar cantidad"
              >
              <Icon name="plus" size={20} />
              </button>
            </div>
          </div>
        
        <div class="reveal-on-scroll space-y-3" style="--reveal-delay: 220ms;">
          <button
            id="add-to-cart"
            data-product={JSON.stringify({
              productId: mappedProduct.id,
              name: mappedProduct.name,
              slug: mappedProduct.slug,
              price: mappedProduct.price,
              ...(mappedProduct.final_price && { finalPrice: mappedProduct.final_price }),
              image: mappedProduct.image,
            })}
            class="w-full cursor-pointer border border-[#2a2520] py-4 font-medium uppercase tracking-[0.16em] text-[#1e1c18] transition duration-200 hover:border-[#FF6800] hover:text-[#ff6800]"
          >
            Añadir al carrito
          </button>
          
          <a
            href="/tienda"
            class="block w-full mb-8 border border-[#c8c1b7] py-4 text-center font-medium uppercase tracking-[0.16em] text-[#5b5144] transition hover:border-[#FF6800] hover:text-[#ff6800]"
          >
            Seguir comprando
          </a>
        </div>

        {mappedProduct.description && (
          <section class="pt-2">
            {/* <h2 class="mb-3 text-base font-semibold text-[#1e1c18]">Descripción del producto</h2> */}
            <div class="leading-relaxed text-[#4b4339]">
              <div
                class="description-content-inner text-md"
                set:html={formatTextToHtml(mappedProduct.description)}
              />
            </div>
          </section>
        )}
        
        <div class="space-y-2 pt-8 text-sm text-[#3f382f]">
          <div class="mb-6 flex w-full items-center justify-center border-t border-[#cfc6b8]"></div>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Producto bajo pedido (sin límite de stock)
          </p>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Envío discreto
          </p>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Pago seguro
          </p>
          <p class="flex items-center">
            <Icon name="check" size={16} class="mr-2 text-green-500" />
            Atención personalizada
          </p>
        </div>
      </div>
    </div>

    {relatedProducts.length > 0 && (
      <section class="mt-16 border-t border-gray-300 pt-12">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="mb-2 font-sans text-[11px] uppercase tracking-[0.3em] text-[#8b8a83]">Recomendados para ti</p>
            <h2 class="font-serif text-[1.8rem] font-normal tracking-wide text-[#1e1c18]">También te puede interesar</h2>
          </div>
          <a
            href="/tienda"
            class="inline-flex border border-[#2a2520] px-4 py-2 text-[11px] uppercase tracking-[0.24em] text-[#1e1c18] transition-colors duration-200 hover:border-[#b4704a] hover:text-[#b4704a]"
          >
            Ver catálogo completo
          </a>
        </div>

        <ProductGrid products={relatedProducts} />
      </section>
    )}

    <aside
      id="product-sticky-bar"
      class="pointer-events-none fixed inset-x-2 bottom-14 z-44 translate-y-4 border border-[#2a2520] bg-[#0f0f0e]/97 p-3 opacity-0 shadow-2xl transition-all duration-250 sm:inset-x-6 sm:bottom-16 md:inset-x-auto md:right-6 md:w-107.5"
      aria-live="polite"
    >
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="truncate text-[10px] uppercase tracking-[0.2em] text-[#8b8a83]">{stickyShortName}</p>
          <div class="mt-1 flex items-center gap-2">
            <span class="font-semibold text-[#f0ece4]">{formatPrice(displayPrice)}</span>
            {hasDiscount && (
              <>
                <span class="text-xs text-[#8b8a83] line-through">{formatPrice(mappedProduct.price)}</span>
                <span class="border border-[#fa0644]/40 bg-[#fa0644]/12 px-1.5 py-0.5 text-[10px] uppercase tracking-[0.12em] text-[#fa0644]">
                  -{mappedProduct.discount_pct}%
                </span>
              </>
            )}
          </div>
        </div>

        <button
          id="sticky-add-to-cart"
          type="button"
          class="shrink-0 cursor-pointer border border-[#2a2520] bg-[#14110f] px-3.5 py-2 text-[10px] uppercase tracking-[0.18em] text-[#f0ece4] transition-colors duration-200 hover:border-[#b4704a]"
        >
          Anadir al carrito
        </button>
      </div>
    </aside>
  </main>

  <style>
    .description-content-inner :global(*) {
      color: inherit;
    }

    .description-content-inner :global(p) {
      margin-bottom: 0.75rem;
    }
    .description-content-inner :global(p:last-child) {
      margin-bottom: 0;
    }
    .description-content-inner :global(strong) {
      font-weight: 700;
    }
    .description-content-inner :global(em) {
      font-style: italic;
    }
    
  </style>

  <script>
    import { useCartStore } from '../../stores/cartStore';

    // Cambio de imagen en galería
    const mainImage = document.getElementById('main-image') as HTMLImageElement | null;
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    
    thumbnails.forEach(btn => {
      btn.addEventListener('click', () => {
        const newSrc = (btn as HTMLElement).dataset.image;
        if (newSrc && mainImage instanceof HTMLImageElement) {
          mainImage.src = newSrc;
        }
      });
    });
    
    // Control de cantidad
    const quantityInput = document.getElementById('quantity') as HTMLInputElement;
    const decreaseBtn = document.getElementById('decrease-qty');
    const increaseBtn = document.getElementById('increase-qty');
    const stickyBar = document.getElementById('product-sticky-bar');
    const stickyAddToCartBtn = document.getElementById('sticky-add-to-cart') as HTMLButtonElement | null;
    
    decreaseBtn?.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value) || 1;
      if (currentValue > 1) {
        quantityInput.value = String(currentValue - 1);
      }
    });
    
    increaseBtn?.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value) || 1;
      quantityInput.value = String(currentValue + 1);
    });
    
    // Validar que el input siempre sea >= 1
    quantityInput?.addEventListener('change', () => {
      const value = parseInt(quantityInput.value) || 1;
      if (value < 1) {
        quantityInput.value = '1';
      }
    });
    
    function addProductToCart(targetButton: HTMLButtonElement, quantity: number) {
      const productData = targetButton.dataset.product || addToCartBtn?.dataset.product;
      if (!productData) {
        return;
      }

      const product = JSON.parse(productData);

      useCartStore.getState().addItem({
        ...product,
        quantity,
      });

      const originalText = targetButton.textContent;
      targetButton.textContent = '✓ Añadido';
      targetButton.classList.add(
        'bg-green-600',
        'text-white',
        'border-green-600',
        'hover:bg-green-600',
        'hover:text-white',
        'hover:border-green-600',
      );

      setTimeout(() => {
        targetButton.textContent = originalText;
        targetButton.classList.remove(
          'bg-green-600',
          'text-white',
          'border-green-600',
          'hover:bg-green-600',
          'hover:text-white',
          'hover:border-green-600',
        );
      }, 1700);
    }

    // Añadir al carrito
    const addToCartBtn = document.getElementById('add-to-cart') as HTMLButtonElement | null;
    addToCartBtn?.addEventListener('click', () => {
      const quantity = parseInt(quantityInput?.value || '1');
      addProductToCart(addToCartBtn, quantity);
    });

    stickyAddToCartBtn?.addEventListener('click', () => {
      const quantity = parseInt(quantityInput?.value || '1');
      addProductToCart(stickyAddToCartBtn, quantity);
    });

    function toggleStickyBar() {
      if (!stickyBar || !addToCartBtn) return;
      const triggerRect = addToCartBtn.getBoundingClientRect();
      const shouldShow = triggerRect.bottom < 0;

      stickyBar.classList.toggle('opacity-0', !shouldShow);
      stickyBar.classList.toggle('translate-y-4', !shouldShow);
      stickyBar.classList.toggle('pointer-events-none', !shouldShow);
      stickyBar.classList.toggle('opacity-100', shouldShow);
      stickyBar.classList.toggle('translate-y-0', shouldShow);
      stickyBar.classList.toggle('pointer-events-auto', shouldShow);
    }

    window.addEventListener('scroll', toggleStickyBar, { passive: true });
    window.addEventListener('resize', toggleStickyBar);
    toggleStickyBar();
  </script>
</BaseLayout>