---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGrid from "../components/sections/ProductGrid.astro";
import FilterPanel from "../components/ui/FilterPanel.astro";
import { supabase } from "../lib/supabase";
import type { Product } from "../types/product";
import { Icon } from "astro-icon/components";

const { data: products, error } = await supabase
  .from("products")
  .select(`
    *,
    product_categories (
      categories (
        id,
        label,
        slug
      )
    )
  `)
  .eq("active", true)
  .order("created_at", { ascending: false });

if (error) {
  console.error("Error fetching products:", error);
}

const mappedProducts: Product[] = (products || []).map((p) => ({
  ...p,
  categories:
    p.product_categories?.map((pc: any) => pc.categories).filter(Boolean) || [],
  category_ids:
    p.product_categories?.map((pc: any) => pc.categories?.id).filter(Boolean) || [],
}));

const { data: categories } = await supabase
  .from("categories")
  .select("*")
  .eq("active", true)
  .order("order_position");

const activeCategoriesCount = (categories || []).length;
const shopHeroImage = "/imgs/category/prueba4.jpg";
---

<BaseLayout
  title="Tienda Online | Kuruba Sexshop"
  description="🛍️ Explora nuestro catálogo completo: juguetes eróticos, vibradores, lubricantes y más. ✅ Precios especiales ✅ Envío discreto a toda Colombia ✅ Pago seguro."
  keywords="tienda erótica, catálogo sexshop, comprar juguetes sexuales, productos eróticos colombia, sexshop online, tienda para adultos"
>
  <main class="min-h-screen bg-[#f8f5ef] dark:bg-[#0A0A0A] pb-20">
    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-[#1e1c18] bg-[#0a0a0a] px-8 pt-20 pb-18">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <img
          src={shopHeroImage}
          alt=""
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover opacity-[0.38]"
        />
        <div class="absolute inset-0 z-1 bg-linear-to-b from-[rgba(10,10,10,0.55)] to-[rgba(10,10,10,0.86)]"></div>
        <div class="pointer-events-none absolute inset-0 z-1 bg-[radial-gradient(ellipse_90%_70%_at_75%_40%,rgba(180,80,50,0.07)_0%,transparent_65%)]"></div>
      </div>

      <div class="relative z-2 mx-auto max-w-300">
        <div class="mb-[1.6rem] flex items-center gap-3 font-sans text-[12px] font-normal uppercase tracking-[0.3em] text-[#fa0644] before:inline-block before:h-px before:w-7 before:shrink-0 before:bg-current before:content-['']">
          Kuruba SexShop
        </div>

        <h1 class="mb-[1.4rem] max-w-175 font-serif text-[clamp(2.2rem,5vw,4rem)] tracking-wide leading-[1.1] text-[#f0ece4]">
          Placer con <em class="italic text-[#FE6700]">discreción</em>,<br />
          entregado en toda Colombia
        </h1>

        <p class="mb-[2.8rem] max-w-120 font-sans text-[15px] tracking-wide font-light leading-[1.75] text-[#6a6560]">
          Una selección cuidada para tu bienestar íntimo. Envío discreto garantizado y experiencia de compra segura.
        </p>

        <div class="flex flex-wrap items-center gap-[2.8rem] max-sm:gap-[1.8rem]">
          <div class="flex flex-col gap-1">
            <span id="product-count" class="font-serif text-[1.7rem] font-normal leading-none text-[#f0ece4]">
              {mappedProducts.length}
            </span>
            <span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#8b8a83]">
              Productos
            </span>
          </div>

          <div class="h-9 w-px shrink-0 bg-[#1e1c18] max-sm:hidden"></div>

          <div class="flex flex-col gap-1">
            <span class="font-serif text-[1.7rem] font-normal leading-none text-[#f0ece4]">
              {activeCategoriesCount}
            </span>
            <span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#8b8a83]">
              Categorías
            </span>
          </div>

          <div class="h-9 w-px shrink-0 bg-[#1e1c18] max-sm:hidden"></div>

          <div class="flex flex-col gap-1">
            <span class="font-serif text-[1.7rem] font-normal leading-none text-[#f0ece4]">
              100%
            </span>
            <span class="font-sans text-[12px] uppercase tracking-[0.25em] text-[#8b8a83]">
              Envío discreto
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- CATALOG -->
    <div class="mx-auto max-w-300 px-8">
      <div class="flex flex-wrap items-end justify-between gap-6 border-[#1a1a18] py-12 pb-[2.2rem] max-sm:pt-8">
        <div>
          <p class="mb-2 font-serif text-[12px] uppercase tracking-[0.3em] text-[#000000] dark:text-[#8b8a83]">
            Catálogo completo
          </p>
          <h2 class="font-serif text-[2rem] font-normal leading-none text-[#000000] dark:text-[#f0ece4] max-sm:text-[1.6rem]">
            Selección premium
          </h2>
        </div>

        <button
          id="open-filters"
          class="inline-flex cursor-pointer items-center gap-2.5 border border-[#2a2520] bg-transparent px-6 py-2.75 font-sans tracking-[5px] text-[12px] font-normal uppercase text-black dark:text-[#8b8a83] transition-colors duration-200 hover:border-[#b4704a] dark:hover:text-[#f0ece4]"
          aria-label="Abrir filtros"
        >
          <Icon name="filter" />
          Filtrar catálogo
        </button>
      </div>

      <div class="border-x border-b border-[#d3d3d3] bg-[#d3d3d3] dark:border-x dark:border-b dark:border-[#1a1a18] dark:bg-[#1a1a18]">
        <ProductGrid products={mappedProducts} />
      </div>
    </div>
  </main>

  <FilterPanel categories={categories || []} />
</BaseLayout>